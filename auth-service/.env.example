# Auth Service Environment Variables
# Copy this file to .env and fill in your actual values

# Port for the auth service
PORT=3000

# Neon PostgreSQL connection string (plain pg driver)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# Secret key used by better-auth — must match the backend BETTER_AUTH_SECRET
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your-very-long-secret-key-here

# The public URL where this auth service is deployed
# Use http://localhost:3000 for local dev
BETTER_AUTH_URL=http://localhost:3000
