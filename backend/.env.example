# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Neon PostgreSQL connection string (asyncpg driver for async FastAPI)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# Neon Auth Base URL — from Neon Console → Project → Auth → Configuration tab
# This is the managed auth server that Flutter talks to directly
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth

# Port to run the FastAPI server on
PORT=8000
