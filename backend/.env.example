# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Neon PostgreSQL connection string (asyncpg driver for async FastAPI)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# Secret key for JWT signing — use a strong random string (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BETTER_AUTH_SECRET=your-very-long-secret-key-here

# JWT algorithm
JWT_ALGORITHM=HS256

# Port to run the FastAPI server on
PORT=8000
